{/* Pattern strip — right side only */}
<div
  className="pointer-events-none absolute right-0 top-0 hidden h-full w-[160px] md:block"
  style={{
    backgroundColor: "#0C1517",

    WebkitMaskImage: "url('/assets/pattern.png')",
