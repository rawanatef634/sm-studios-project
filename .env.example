# ============================================================
# SM Studios — required environment variables
# ============================================================
# Preferred local workflow (pulls secrets from your Vercel project):
#   vercel link
#   vercel env pull .env.local
#
# Or copy this file to .env.local and fill in values manually.
# NEVER commit a .env / .env.local file with real secrets.
# ============================================================

# Staff admin username
ADMIN_USERNAME=admin

# Bcrypt hash of the admin password (work factor 12).
# Generate with: npm run generate-hash -- yourPassword
ADMIN_PASSWORD_HASH=<bcrypt_hash_here>

# Cryptographically secure session secret (min 64 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=<64_char_random_hex_string>

# Vercel Blob read/write token for the PUBLIC store.
# Project images are public website assets; the store must be PUBLIC.
# A private store rejects access: "public" writes.
#
# If the project-default store is private, connect a public store and use
# SMS_PUBLIC_READ_WRITE_TOKEN (preferred). BLOB_READ_WRITE_TOKEN is the
# fallback when only one store is connected.
#
# Pull locally with: vercel env pull .env.local
#
# If this is unset locally:
#   - Projects API uses .data/projects.local.json (temporary; cleared on npm run dev)
#   - Image uploads save to public/uploads/ and return /uploads/<file> URLs
#
# REQUIRED on Vercel Production/Preview for persistent projects + cloud uploads.
# Without it, the API still returns the bundled seed (so the site is not blank),
# but dashboard edits/uploads will not persist across deploys.
SMS_PUBLIC_READ_WRITE_TOKEN=<public_blob_store_token_here>
BLOB_READ_WRITE_TOKEN=<vercel_blob_token_here>

# Transactional email (Contact + Careers forms). Server-only — never prefix with VITE_.
# Create an API key at https://resend.com and add it in the Vercel project
# Environment Variables (Production, Preview, and Development).
# Verify smstudios-om.com in Resend, then set the From address to a verified sender.
RESEND_API_KEY=<resend_api_key_here>
RESEND_FROM_EMAIL=SM Studios <noreply@smstudios-om.com>
